  "chapters": [
    {
      "chapter": "preliminary",
      "review_and_revision": "先解释概率、logprob、loss 与梯度；用两动作重加权引出 IS，再比较 PPO/CISPO 的实际导数，区分 loss 值和梯度。"
    },
    {
      "chapter": "001-ppo",
      "review_and_revision": "重建动机、五类角色、状态/回报、reference 奖励、TD→GAE、裁剪与 critic 学习链；补完整数据流图和两步手算；复读补上当前 critic 输入并纠正比率公式的多余加号。"
    },
    {
      "chapter": "002-dpo",
      "review_and_revision": "从固定偏好对与 teacher forcing 进入 margin；分三步解释 Bradley–Terry、最优策略重参数化与同题 Z 抵消；补首次符号和 KL 定义。"
    },
    {
      "chapter": "01-grpo",
      "review_and_revision": "解释 group/batch、为什么必须同题、为何不用 value critic；补奖励→优势→token 裁剪数值例子及 mask、长度、KL 的定义。"
    },
    {
      "chapter": "02-opd",
      "review_and_revision": "解释 SFT/OPD 与遗忘测量，分开教师初始化和学生起点；用连续两步梯度说明 SAR/IDT 顺序不等价，不编造调度缩写全称。"
    },
    {
      "chapter": "02-opd/general-opd",
      "review_and_revision": "从学生错误前缀说明 on-policy 动机；区分完整教师分布与采样反馈；补两个候选例子、固定反馈、token 身份对齐和局部估计边界。"
    },
    {
      "chapter": "03-search-r1",
      "review_and_revision": "用两跳查询区分固定 RAG 与可学习检索；说明轨迹/行动/观察和不可微工具为何不妨碍策略更新，再进入 mask 与代码。"
    },
    {
      "chapter": "04-opsd",
      "review_and_revision": "从相同条件无新信号推导特权 solution 的作用；区分自蒸馏与 SFT，解释教师额外上下文导致的位置偏移和评估边界。"
    },
    {
      "chapter": "05-retool",
      "review_and_revision": "用正确工具、错误程序的例子分清完整决策；补代码 token 的更新手算和终局信用的局限，区分执行器验证与整体策略效果。"
    },
    {
      "chapter": "06-dapo",
      "review_and_revision": "用 8 组中 6 组退化解释数据供应问题；串起非对称裁剪、按原奖励筛组、长度塑形、有效 token 聚合与生成预算。"
    },
    {
      "chapter": "07-gspo",
      "review_and_revision": "区分 reward、advantage、ratio；用长度连乘和几何平均例子引出序列尺度，说明共享权重不等于共享参数梯度。"
    },
    {
      "chapter": "08-alfworld",
      "review_and_revision": "用开柜子找苹果故事解释 episode/reset/step、观察与状态；先讲 MDP/POMDP 和终止，再接环境中的 GRPO 学习。"
    },
    {
      "chapter": "09-AgentOPSD",
      "review_and_revision": "从失败轨迹中的正确早期动作引出信用分配；解释 Skill、log-odds、belief 和记忆衰减，再进入不翻转终局方向的有界重加权。"
    },
    {
      "chapter": "09-tempo",
      "review_and_revision": "先解释宏步、自举、重放各解决什么，再讲短分支目标和生成式 critic；复读修正分支数与价值目标符号复用，保留来源核验限制。"
    },
    {
      "chapter": "09-vision-grpo",
      "review_and_revision": "用角度题解释相同图文条件分组；说明 processor、视觉条件依赖、loss mask 与参数冻结之间的区别。"
    },
    {
      "chapter": "12-harness-rl",
      "review_and_revision": "从工具选对但参数写错解释两类反馈；依次定义 harness/session/call、两种 mask、CAPO 梯度路由；将 MLP/FSDP 定义移到首次使用。"
    },
    {
      "chapter": "13-sac",
      "review_and_revision": "从连续 Q、离策略回放进入熵动机；补离散熵直觉、Bellman 标签与目标网络、重参数化及 tanh 密度修正。"
    },
    {
      "chapter": "14-td3",
      "review_and_revision": "先介绍 DDPG 和动作梯度，再用高估反馈说明三个机制；区分探索噪声/目标噪声、环境步/更新步并补符号。"
    },
    {
      "chapter": "15-her",
      "review_and_revision": "先说明稀疏反馈和真实失败经历的信息，再区分 desired/achieved goal；解释重算标签、负奖励 hindsight 的价值传播和原目标评估。"
    },
    {
      "chapter": "16-iql",
      "review_and_revision": "先区分 offline 与 BC，再解释数据外动作高估；串起 expectile V、Bellman Q、正权重模仿，补标量最优值的导数步骤。"
    }
  ],
